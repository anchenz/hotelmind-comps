{
  "name": "@tourmindai/components",
  "version": "1.0.18",
  "description": "TourmindAI Components",
  "type": "module",
  "main": "dist/tourmindai-components.umd.js",
  "module": "dist/tourmindai-components.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/tourmindai-components.es.js",
      "require": "./dist/tourmindai-components.umd.js"
    },
    "./es": "./dist/tourmindai-components.es.js",
    "./lib": "./dist/tourmindai-components.umd.js",

    "./styles/components": "./dist/styles/components.css",
    "./styles/all": "./dist/styles/all.css",
    "./styles/theme": "./dist/styles/theme.css",

    "./hooks": "./dist/hooks/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && npm run build:styles && npm run build:hooks",
    "build:styles": "node scripts/build-styles.js",
    "build:hooks": "node scripts/build-hooks.js",
    "dev": "vite",
    "dev:lib": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "sass": "^1.78.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.9",
    "vue": "^3.3.4",
    "vue-router": "^4.2.0"
  },
  "dependencies": {
    "pinia": "^3.0.1"
  }
}
